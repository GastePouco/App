# Banco: desenvolvimento e testes no Postgres do Docker (docker compose up -d db).
# As duas variaveis existem porque o Prisma separa a conexao de uso (url) da
# conexao de migration (directUrl). Aqui elas apontam para o mesmo banco.
DATABASE_URL="postgresql://gastemenos:gastemenos@127.0.0.1:5435/gastemenos?schema=public"
DIRECT_URL="postgresql://gastemenos:gastemenos@127.0.0.1:5435/gastemenos?schema=public"

# Em producao (Supabase), trocar pelas duas conexoes do painel — ver
# docs/13-SUPABASE.md. O pooler da 6543 nao aceita DDL; migration usa a 5432.
# DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<SENHA>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# DIRECT_URL="postgresql://postgres.<PROJECT-REF>:<SENHA>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Fila da leitura de nota. O Supabase nao tem Redis: em producao aponte para o
# Redis do servidor (Coolify, Upstash ou container proprio).
REDIS_URL="redis://localhost:6379"

# Arquivos gerados pela API (ZIP do "Baixar meus dados").
# Sem SUPABASE_URL + SUPABASE_SECRET_KEY, ficam em disco, nesta pasta.
# Em producao o disco do container e efemero: preencha os dois. O balde precisa
# ser PRIVADO. A chave secreta (sb_secret_...) e so de servidor: nunca no web.
# A chave publicavel (sb_publishable_...) nao e usada em lugar nenhum — o web
# fala com a nossa API, nunca com o Supabase.
EXPORT_DIR="./exportacoes"
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="exportacoes"

# Tokens de sessao
JWT_SECRET="troque-em-producao-min-32-caracteres-aqui"
JWT_REFRESH_SECRET="troque-tambem-em-producao-min-32-caracteres"

# Hash das observacoes de preco (LGPD: userHash = HMAC do userId)
USER_HASH_SECRET="troque-em-producao-segredo-do-hmac-de-usuario"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/v1/auth/google/callback"

# Web Push (gere com: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@gastemenos.com.br"

# E-mail
MAIL_FROM="GasteMenos <nao-responda@gastemenos.com.br>"
# Vazio em desenvolvimento: o codigo de 6 digitos vai para o log da API,
# para dar para testar o cadastro sem caixa postal. Preencha para enviar de verdade.
SMTP_URL=""

# Recompensa por notas lidas (docs/18-RECOMPENSAS.md)
# Parametros de campanha: trocar campanha nao exige deploy. Valor invalido
# (letra, zero, negativo) cai no padrao e avisa no log.
# Primeiro marco em notas que viraram dado (padrao 25; o pedido original era 200)
REWARD_FIRST_MILESTONE=25
# Notas entre um marco e o seguinte (padrao 50)
REWARD_MILESTONE_STEP=50
# Quanto cada marco credita, em centavos (padrao 200 = R$ 2,00)
REWARD_MILESTONE_CENTS=200
# Teto de credito por mes, somando todas as pessoas (padrao 50000 = R$ 500,00).
# Estourado o teto, o marco nao e perdido: entra no ciclo seguinte.
REWARD_MONTHLY_BUDGET_CENTS=50000

# Geocodificacao das lojas
GEOCODER_URL="https://nominatim.openstreetmap.org/search"
GEOCODER_USER_AGENT="GasteMenos/0.1 (contato@gastemenos.com.br)"

# Enderecos
APP_URL="http://localhost:5173"
API_URL="http://localhost:3001"
PORT=3001
NODE_ENV=development

# Multiplica os limites de requisicao, SOMENTE para a suite automatizada:
# os 3 projetos do Playwright rodam do mesmo IP e o limite e por IP.
# O boot recusa este valor em producao.
RATE_LIMIT_TEST_FACTOR=20
