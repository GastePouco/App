{
  "name": "@gastemenos/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run --reporter=verbose src/**/*.a11y.test.tsx",
    "test:e2e": "playwright test",
    "lint": "eslint src e2e",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gastemenos/shared": "workspace:*",
    "@gastemenos/ui": "workspace:*",
    "@tanstack/query-async-storage-persister": "^5.103.3",
    "@tanstack/react-query": "^5.103.3",
    "@tanstack/react-query-persist-client": "^5.103.3",
    "@zxing/browser": "^0.1.5",
    "idb-keyval": "^6.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^6.30.6",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@gastemenos/tokens": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.9",
    "vitest-axe": "^0.1.0",
    "workbox-window": "^7.4.1"
  }
}
