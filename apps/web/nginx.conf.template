# Serve o PWA e repassa /v1 para a API.
#
# O proxy existe para o web e a API ficarem na **mesma origem**: é isso que faz
# o cookie de refresh (httpOnly, SameSite=Lax) funcionar sem precisar de
# SameSite=None, que exigiria terceiros confiáveis e abriria CSRF.

# `${API_HOST}` é trocado na subida pelo entrypoint do nginx (envsubst), por
# isso este arquivo é um template. Sem isso o cifrão chegaria literal ao nginx.
upstream api {
  server ${API_HOST}:3000;
}

server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # O nginx do Coolify já está atrás de HTTPS; estes cabeçalhos completam o
  # básico que o app precisa. A CSP fica no proxy de borda, onde também valem
  # os domínios de fonte.
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  # O app não é para ser embutido em lugar nenhum: iframe do app num site de
  # terceiro é a base de um golpe de clique (a pessoa acha que clica num
  # banner e clica em "encerrar conta").
  add_header X-Frame-Options "DENY" always;

  # CSP com o mínimo que o app usa: nada de script de fora, e as fontes só do
  # Google Fonts, que é de onde elas vêm. `unsafe-inline` no style existe
  # porque o Tailwind e os gráficos em SVG escrevem estilo direto no elemento;
  # em script, não existe — e é lá que o XSS moraria.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;

  location /v1/ {
    proxy_pass http://api/v1/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # A leitura de nota espera o portal da SEFAZ; 60 s é folga sem ser eterno.
    proxy_read_timeout 60s;
  }

  # Arquivos com hash no nome podem ser cacheados para sempre.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # O service worker e o manifest, não: são eles que anunciam a versão nova.
  location = /sw.js {
    add_header Cache-Control "no-cache, must-revalidate";
  }

  location = /manifest.webmanifest {
    add_header Cache-Control "no-cache";
    types { } default_type "application/manifest+json";
  }

  # Qualquer rota do app cai no index.html: o roteamento é do navegador.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
