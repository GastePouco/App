{
  "name": "gastemenos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,md}\"",
    "db:migrate": "pnpm --filter @gastemenos/api prisma migrate dev",
    "db:seed": "pnpm --filter @gastemenos/api prisma db seed",
    "db:studio": "pnpm --filter @gastemenos/api prisma studio",
    "tokens:build": "pnpm --filter @gastemenos/tokens build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.3"
    }
  },
  "type": "module"
}
